{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/u/:username", "destination": "/u" },
    { "source": "/pack/:id", "destination": "/pack" },
    { "source": "/club/:code", "destination": "/club" },
    { "source": "/a-lire/:id", "destination": "/a-lire" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
